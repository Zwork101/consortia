{% extends "base.html.j2" %}
{% block head %}
<script defer src={{ url_for("static", filename="js/admin2.js") }}></script>
{% endblock %}
{% block content %}
{% include "nav.html.j2" %} 
{% include "widgets/db-nav.html.j2" %}

    <table class="dbTable" id="dbTable">
        <tr class="dbTableTop">
            <th></th>
            <th data-column="First Name">FIRST NAME</th>
            <th data-column="Last Name">LAST NAME</th>
            <th>MEMBERSHIP</th><!-- Removed data-column attribute to make non-sortable -->
            <th data-column="Semesters">SEMESTER</th>
            <th data-column="Email">EMAIL ADDRESS</th>
            <th data-column="Mentorship">MENTORSHIP</th>
            <th data-column="Volunteering">VOLUNTEERING</th>
            <th data-column="Attendance">ATTENDANCE</th>
            <th data-column="Misc">MISC</th>
            <th data-column="Points">TOTAL POINTS</th>
            <th class="dbTablePH"></th>
            <th></th>
        </tr>
    </table>

    <!-- Edit Profile Modal -->
    <div id="editProfileModal" class="modal" style="display:none;">
        <div class="modal-content">
            <span class="close" onclick="document.getElementById('editProfileModal').classList.remove('show-modal')">&times;</span>
            <h2>Edit Profile</h2>
            <form id="editProfileForm" class="edit-profile-form" method="post" action="{{ url_for('admin.confirm_edit_user') }}">
                <input type="hidden" id="edit-user-id" name="user_id">
                <input type="hidden" id="edit-org-id" name="organization_id" value="2">
                
                <div class="form-group">
                    <label for="edit-email">Email:</label>
                    <input type="text" id="edit-email" name="email">
                </div>
                
                <div class="form-group">
                    <label for="edit-first_name">First Name:</label>
                    <input type="text" id="edit-first_name" name="first_name">
                </div>
                
                <div class="form-group">
                    <label for="edit-last_name">Last Name:</label>
                    <input type="text" id="edit-last_name" name="last_name">
                </div>
                
                <div class="form-group">
                    <label for="edit-rit_id">RIT ID:</label>
                    <input type="text" id="edit-rit_id" name="rit_id">
                </div>
                
                <div class="form-group">
                    <label for="edit-graduation_year">Graduation Year:</label>
                    <input type="text" id="edit-graduation_year" name="graduation_year">
                </div>
                
                <div class="form-group">
                    <label for="edit-degree">Degree:</label>
                    <input type="text" id="edit-degree" name="degree">
                </div>
                
                <div class="form-group">
                    <label for="edit-pronouns">Pronouns:</label>
                    <input type="text" id="edit-pronouns" name="pronouns">
                </div>
                
                <div class="form-group">
                    <label for="edit-avatar_path">Avatar Path:</label>
                    <input type="text" id="edit-avatar_path" name="avatar_path">
                </div>
                <!-- BONUS POINTS section for COMS profiles -->
                <div class="form-group">
                    <label for="edit-bonus-points">Bonus Points:</label>
                    <input type="number" id="edit-bonus-points" name="bonus_points" min="1" placeholder="Optional">
                </div>
                <div class="form-group">
                    <label for="edit-bonus-reason">Bonus Reason:</label>
                    <input type="text" id="edit-bonus-reason" name="bonus_reason" placeholder="Optional">
                </div>
                <button type="submit" class="form-submit-button">Save Changes</button>
            </form>
        </div>
    </div>


</main>
<script>
var modal = document.getElementById("modal-rew");
var btn = document.getElementById("modal-rew-Btn");
var span = document.getElementsByClassName("close")[0];
btn.onclick = function() {
  modal.style.display = "block";
}
span.onclick = function() {
  modal.style.display = "none";
}
window.onclick = function(event) {
  if (event.target == modal) {
    modal.style.display = "none";
  }
}

var modal2 = document.getElementById("modal-rep");
var btn2 = document.getElementById("modal-rep-Btn");
var span2 = document.getElementsByClassName("close2")[0];
btn2.onclick = function() {
  modal2.style.display = "block";
}
span2.onclick = function() {
  modal2.style.display = "none";
}
window.onclick = function(event) {
  if (event.target == modal2) {
    modal2.style.display = "none";
  }
}

function dropDown1() {
    const dropdown = document.getElementById("DropdownContent1");
    const isVisible = dropdown.style.display === "block";
    dropdown.style.display = isVisible ? "none" : "block";
}

// Close dropdown when clicking outside
document.addEventListener("click", function(event) {
    const dropdown = document.getElementById("DropdownContent1");
    const button = document.querySelector(".dropbtn1");
    if (!dropdown.contains(event.target) && !button.contains(event.target)) {
        dropdown.style.display = "none";
    }
});

</script>
{% endblock %}