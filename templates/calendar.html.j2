
    <script>
        $(document).ready(function() {
            let currentDate = new Date();
            
            function renderCalendar(date) {
                let month = date.toLocaleString('default', { month: 'long' });
                let year = date.getFullYear();
                $('#month-title').text(`${month} ${year}`);
    
                let firstDay = new Date(year, date.getMonth(), 1).getDay();
                let lastDate = new Date(year, date.getMonth() + 1, 0).getDate();
                
                let calendarHTML = "";
                let weekdays = ["S", "M", "T", "W", "T", "F", "S"];
                weekdays.forEach(day => {
                    calendarHTML += `<div class="weekday">${day}</div>`;
                });
                for (let i = 0; i < firstDay; i++) {
                    calendarHTML += '<div class="day empty"></div>';
                }
                for (let i = 1; i <= lastDate; i++) {
                    calendarHTML += `<div class="day" data-date="${year}-${date.getMonth() + 1}-${i}">${i}</div>`;
                }
                $('.calendar-grid').html(calendarHTML);
    
                // Highlight today's date by default
                let today = new Date();
                if (today.getMonth() === date.getMonth() && today.getFullYear() === date.getFullYear()) {
                    $('.day').each(function() {
                        if ($(this).text() == today.getDate()) {
                            $(this).addClass('selected');
                        }
                    });
                }
    
                // Add click event to select a date
                $('.day').click(function() {
                    $('.day').removeClass('selected');
                    $(this).addClass('selected');
                    let selectedDate = $(this).data('date');
                    console.log(selectedDate); // Log the selected date

                    $.get(`/meetings/{{ org }}?selected_Date=${selectedDate}`, function (data)) {
                    $('#meetings-container').html(data);
                }
                });                

            }
            
            renderCalendar(currentDate);
            
            $('#prev').click(function() {
                currentDate.setMonth(currentDate.getMonth() - 1);
                renderCalendar(currentDate);
            });
    
            $('#next').click(function() {
                currentDate.setMonth(currentDate.getMonth() + 1);
                renderCalendar(currentDate);
            });
        });
    </script>
    
</head>
<body>
    <div class="main-container">
        <div class="calendar-container">
            <div class="calendar-header">
                <button id="prev"><img src="../static/images/prev-arrow.png" style="width:16px;" /></button>
                <h2 id="month-title"></h2>
                <button id="next"><img src="../static/images/next-arrow.png" style="width:16px;" /></button>
            </div>
            <div class="calendar-grid"></div>
        </div>
        <div class="events-container">
            <div class="event">
               <div class="meeting-marker" style="background-color: #009CBD;"></div>
               <p class="calendar-status">Status: Attended</p>
               <strong>General Meeting</strong> <!--replace data with 1st upcoming meeting according to calendar-->
               <p>WED • 6:30PM - 7:30PM</p>
               <p>GOL - 2400 / Zoom</p>
            </div>
            <div class="event">
                <div class="meeting-marker" style="background-color: #84BC00;"></div>
                <p class="calendar-status">Status: Unattended</p>
                <strong>Projects Committee</strong> <!--replace data with 2nd upcoming meeting according to calendar-->
                <p>THURS • 6:30PM - 7:30PM</p>
                <p>GOL - 2400</p>
            </div>
            <div class="event">
                <div class="meeting-marker" style="background-color: #7D55C7;"></div>
                <p class="calendar-status">Status: Unattended</p>
                <strong>WiCHacks Committee</strong> <!--replace data with 3rd upcoming meeting according to calendar-->
                <p>THURS • 7:00PM - 8:00PM</p>
                <p>GOL - 2350</p>
            </div>
            <div class="event">
                    {% for meeting in meetings %}
                        <div class="event">
                        {% if 'GENERAL' in meeting.meeting_type.name %}
                            <div class="meeting-marker" style="background-color: #009CBD;"></div>
                        {% endif %}
                        {% if 'COMMITTEE' in meeting.meeting_type.name %}
                            <div class="meeting-marker" style="background-color: #84BC00;"></div>
                        {% endif %}
                        {% if 'MENTORSHIP' in meeting.meeting_type.name %}
                            <div class="meeting-marker" style="background-color: #7D55C7;"></div>
                        {% endif %}
                        {% if 'SOCIAL' in meeting.meeting_type.name %}
                            <div class="meeting-marker" style="background-color: #C099F7;"></div>
                        {% endif %}
                        {% if 'VOLUNTEER' in meeting.meeting_type.name %}
                            <div class="meeting-marker" style="background-color: #66B4C4;"></div>
                        {% endif %}
                        <strong>{{ meeting.name }} Meeting</strong><br>
                        <p> {{ meeting.start_time.strftime('%A • %I:%M %p') }} – {{ meeting.end_time.strftime('%I:%M %p') }} </p><br>
                        <p>{{ meeting.location }}</p>
                    {% else %}
                        <li>No upcoming meetings found.</li>
                    {% endfor %}
                        </div>
            </div>
            <div id="meetings-container">
                <p>pauls</p>
            </div> 
            
        </div>
    </div>
    
</body>
</html>
