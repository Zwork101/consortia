{% extends "base.html.j2" %}
{% block head %}
<script src="../static/js/mainjavascript.js"></script>
{% endblock %}
{% block content %}
{% include "nav.html.j2" %} 
	<main>

        <h2 style="margin-left: 80px; margin-top: 80px;">{{ user.first_name }} {{ user.last_name }}</h2>
        <div class="profile-container">
            <div class="profile-sec">
                <h3>MEMBERSHIP INFORMATION</h3>
                <div class="profile-subsec">
                    <h4>Membership:</h4>
                    <p>{{ user.membership }}</p>

                    <h4>Semester:</h4>
                    <p>Semesters with group</p>

                    <h4>Awards:</h4>
                    <!-- Loop Awards Recieved --!>
                    <p>Awards Received</p>

                    <h4 style="opacity:0%;">placeholder</h4>
                    <p style="opacity:0%;">placeholder</p>
                </div>
                <div class="profile-subsec" style="margin-left: 100px;">
                    <h4>General Meetings:</h4>
                    <p>x/14</p>

                    <h4>Committee Meetings:</h4>
                    <p>x/6</p>

                    <h4>Social Events:</h4>
                    <p>x/1</p>

                    <h4>Volunteering:</h4>
                    <p>x/1</p>
                </div>
            </div>
        </div>
        <div class="profile-container">
            <div class="profile-sec">
                <form>
                    <h3>PERSONAL INFORMATION</h3>
                    <div class="profile-subsec">
                        <h4>Graduation Year:</h4>
                        <input type="text" id="graduation-year" name="graduation-year" value="{{ user.graduation_year }}">

                        <h4>Degree:</h4>
                        <input type="text" id="degree" name="degree" value="{{ user.degree }}">

                        <h4 style="opacity:0%;">placeholder</h4>
                        <p style="opacity:0%;">placeholder</p>

                        <h4 style="opacity:0%;">placeholder</h4>
                        <p style="opacity:0%;">placeholder</p>
                    </div>
                    <div class="profile-subsec" style="margin-left: 100px;">
                        <h4>Pronouns:</h4>
                        <input type="text" id="pronouns" name="pronouns" value="{{ user.pronouns }}">

                        <h4>T-shirt size:</h4>
                        <input type="text" id="size" name="size" value="DataHere">

                        <h4 style="opacity:0%;">placeholder</h4>
                        <p style="opacity:0%;">placeholder</p>

                        <h4 style="opacity:0%;">placeholder</h4>
                        <p style="opacity:0%;">placeholder</p>

                        <button class="semester-report-btn savebtn">Save Changes</button>
                    </div>
                </form>
            </div>
        </div>

    </main>
{% endblock %}