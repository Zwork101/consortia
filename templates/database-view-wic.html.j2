{% extends "base.html.j2" %}
{% block head %}
<script src="../static/js/mainjavascript.js"></script>
{% endblock %}
{% block content %}

<div id="filter-dialog-box" title="Filters">
    <form name="filter-settings" id="filter-settings" method="post">
        <fieldset>
            <div>
                <select name="filter-sort-by" id="filter-sort-by">
                    <option>Sort by: First Name</option>
                    <option>Sort by: Last Name</option>
                </select>
                <select name="filter-sort-order" id="filter-sort-order">
                    <option>Ascending</option>
                    <option>Decending</option>
                </select>
            </div>
            <div> 
                <label for="filter-membership">Membership</label>
                <select name="filter-membership" id="filter-membership">
                    <option>All</option>
                    <option>None</option>
                </select>    
            </div>
            <div>
                <label for="filter-semesters">Semesters</label>
                <select name="filter-semesters" id="filter-semesters">
                    <option>All</option>
                    <option>None</option>
                </select>
            </div>
            <div>
                <label for="filter-gen-meetings">Gen. Meetings</label>
                <select name="filter-gen-meetings" id="filter-gen-meetings">
                    <option>All</option>
                    <option>None</option>
                </select>
            </div>
            <div>
                <label for="filter-con-meetings">Com. Meetings</label>
                <select name="filter-con-meetings" id="filter-con-meetings">
                    <option>All</option>
                    <option>None</option>
                </select>
            </div>
            <div>
                <label for="filter-social-event">Social Event</label>
                <select name="filter-social-event" id="filter-social-event">
                    <option>All</option>
                    <option>None</option>
                </select>
            </div>
            <div>
                <label for="filter-volunteering">Volunteering</label>
                <select name="filter-volunteering" id="filter-volunteering">
                    <option>All</option>
                    <option>None</option>
                </select>
            </div>
            <!-- allow for form submission without duplicating the dialog button-->
            <!-- <input type="submit" tabindex="-1" style="position: absolute; top: -1000px"> -->
        </fieldset>
    </form>
</div>

<div id="create-meeting-dialog-box" title="Create Meeting">
    <form name="create-meeting" id="create-meeting" method="post">
        <fieldset>
            <div class="dialog-item">
                <label for="meeting-title">Title:</label>
                <input type="text" name="meeting-title" id="meeting-title">
            </div>
            <div class="dialog-row">
                <div>
                    <label for="meeting-date">Date:</label>
                    <input type="date" name="meeting-date" id="meeing-date">
                </div>
                <div>
                    <label for="meeting-time-start">Start Time:</label>
                    <select name="meeting-time-start" id="meeting-time-start">
                        <option>12am</option>
                        <option>1am</option>
                        <option>2am</option>
                        <option>3am</option>
                        <option>4am</option>
                        <option>5am</option>
                        <option>6am</option>
                        <option>7am</option>
                        <option>8am</option>
                        <option>9am</option>
                        <option>10am</option>
                        <option>11am</option>
                        <option>12pm</option>
                        <option>1pm</option>
                        <option>2pm</option>
                        <option>3pm</option>
                        <option>4pm</option>
                        <option>5pm</option>
                        <option>6pm</option>
                        <option>7pm</option>
                        <option>8pm</option>
                        <option>9pm</option>
                        <option>10pm</option>
                        <option>11pm</option>
                    </select>
                </div> 
                <div>
                    <label for="meeting-time-end">End Time:</label>
                    <select name="meeting-time-end" id="meeting-time-end">
                        <option>12am</option>
                        <option>1am</option>
                        <option>2am</option>
                        <option>3am</option>
                        <option>4am</option>
                        <option>5am</option>
                        <option>6am</option>
                        <option>7am</option>
                        <option>8am</option>
                        <option>9am</option>
                        <option>10am</option>
                        <option>11am</option>
                        <option>12pm</option>
                        <option>1pm</option>
                        <option>2pm</option>
                        <option>3pm</option>
                        <option>4pm</option>
                        <option>5pm</option>
                        <option>6pm</option>
                        <option>7pm</option>
                        <option>8pm</option>
                        <option>9pm</option>
                        <option>10pm</option>
                        <option>11pm</option>
                    </select>
                </div>
            </div>
            <div class="dialog-row">
                <div>
                    <div class="week-row">
                        <input type="checkbox" id="repeat-days" name="repeat-days"><label for="repeat-days">Repeat Every:</label>
                    </div>
                    <div class="week-row">
                        <input type="checkbox" id="M" name="M"><label for="M">M</label>
                        <input type="checkbox" id="Tu" name="Tu"><label for="Tu">T</label>
                        <input type="checkbox" id="W" name="W"><label for="W">W</label>
                        <input type="checkbox" id="Th" name="Th"><label for="Th">T</label>
                        <input type="checkbox" id="F" name="F"><label for="F">F</label>
                        <input type="checkbox" id="Sat" name="Sat"><label for="Sat">S</label>
                        <input type="checkbox" id="Sun" name="Sun"><label for="Sun">S</label>
                    </div>
                </div>
                <div>
                    <label for="meeting-location">Meeting Location:</label>
                    <input type="text" name="meeting-location" id="meeting-location">
                </div>
            </div>
            <div class="dialog-item">
                <label for="description">Description</label>
                <textarea id="description" rows="6" cols="58"></textarea>
            </div>
        </fieldset>
    </form>
</div>

<div id="import-data-dialog-box" title="Import Data">
    <form name="import-data" id="import-data">
        <fieldset>
            <div>
                <p>Drag and Drop or <span>Choose file</span> to file.</p>
                <p>CSV files only.</p>
            </div>
            <div>
            <!-- left blank for file upload -->
            </div>
            <div>
                <select name="data-event-name" id="data-event-name">
                    <option>Tutoring with Katie</option>
                    <option>Option2</option>
                </select>
                <select name="data-event-date" id="data-event-date">
                    <option>11/22/24</option>
                    <option>Option2</option>
                </select>
            </div>
        </fieldset>
    </form>
</div>

<div id="send-email-dialog-box" title="Send Email">
    <form name="send-email" id="send-email">
        <fieldset>
            <div>
                <label for="send-to">To:</label>
                <input type="text" name="send-to" id="send-to">
            </div>
            <div>
                <textarea id="email-message" rows="6" cols="58"></textarea>
            </div>
            <div class="add-file-button">
                <button>Add Files</button>
            </div>
        </fieldset>
    </form>
</div>


