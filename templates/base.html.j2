<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">
    {% set styles = ["mobile", "calendar", "styles", "normalize/normalize", "jquery/jquery-ui", "dialogue"] %}
    {% for style in styles %}
    <link rel="stylesheet" type="text/css" href="{{ url_for("static", filename="css/" + style + ".css") }}">
    {% endfor %}
    <script src=" https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.min.js "></script>
    <script src="{{ url_for("static", filename="js/jquery-ui.min.js") }}"></script>
    <script defer src="{{ url_for("static", filename="js/dialogs.js") }}"></script>
	<script defer src="{{ url_for("static", filename="js/calendar.js") }}"></script>
    <script src="{{ url_for("static", filename="js/mainjavascript.js") }}"></script>
    <title>{{ title }}</title>
    {% block head %}
    {% endblock %}
</head>
<body data-org="{{ org_id }}">
{% block content %}
{% endblock %}
</body>
</html>