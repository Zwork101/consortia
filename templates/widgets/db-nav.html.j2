<!--Reports Modal -->
<div id="modal-rew" class="modal-rew">
  <div class="modal-rew-content">
  <button class="semester-report-btn report-btn" >Download</button>
    <span class="close">&times;</span>
    <h2 style="margin-left: 80px; margin-top: 80px;">Reports</h2>
        <div class="report-upper" style="margin-left: 80px;">
            <p>Active Members: {{ active_count_members }}</p>

            <p>Inactive Members: {{ inactive_count_members }}</p>

            <p>Alumni Members: {{ alumni_count_memebers }}</p>
        </div>

        <h3 style="margin-left: 80px; transform:translateY(20px);">GRADUATING MEMBERS</h3>

        <table class=" smallerTable" style="margin-top: 100px;">
            <!--THIS TABLE SHOULD LIST ALL MEMBERS GRADUATING THIS YEAR-->
            <tr class="dbTableTop">
                <th></th>
                <th>FIRST NAME</th>
                <th>LAST NAME</th>
                <th>MEMBERSHIP</th>
                <th>SEMESTER</th>
                <th>EMAIL ADRESS</th>
                <th class="dbTablePH"></th>
                <th></th>
            </tr>
                {% for grad_students in graduation_students %}
            <tr class="dbTableRow">
                <td></td>
                <td>{{ grad_students['first_name'] }}</td>
                <td>{{ grad_students['last_name'] }}</td>
                <td>{{ "Active" if grad_students['membership'] else "Inactive" }}</td>
                <td>{{ grad_students['semesters'] }}</td>
                <td>{{ grad_students['email_address'] }}</td>
                <td class="dbTablePH"></td>
                <td></td>
            </tr>
                {% endfor %}
        </table>

        <h3 style="margin-left: 80px; transform:translateY(20px);">ACTIVE MEMBERS</h3>

        <table class=" smallerTable" style="margin-top: 100px;"> <!--THIS TABLE SHOULD LIST ALL ACTIVE MEMBERS DESCENDING BASED ON NUMBER OF SEMESTERS-->
            <tr class="dbTableTop">
                <th></th>
                <th>FIRST NAME</th>
                <th>LAST NAME</th>
                <th>MEMBERSHIP</th>
                <th>SEMESTER</th>
                <th>EMAIL ADRESS</th>
                <th class="dbTablePH"></th>
                <th></th>
            </tr>
                {% for active_students in active %}
            <tr class="dbTableRow">
                <td></td>
                <td>{{ active_students['first_name'] }}</td>
                <td>{{ active_students['last_name'] }}</td>
                <td>{{ "Active" if active_students['membership'] else "Inactive" }}</td>
                <td>{{ active_students['semesters'] }}</td>
                <td>{{ active_students['email_address'] }}</td>
                <td class="dbTablePH"></td>
                <td></td>
            </tr>
                {% endfor %}
        </table>
        </div>
    </div>
</div>

<!--Rewards Modal -->
<div id="modal-rep" class="modal-rew">
<button class="semester-report-btn report-btn" style="margin-left:100px;" id="notify-students">Notify Students</button>
  <div class="modal-rep-content">
    <span class="close2">&times;</span>
    <h2 style="margin-left: 80px; margin-top: 80px;">Rewards</h2>
        <table id="reward-table" class="smallerTable" style="margin-top: 100px;">
            <tr class="dbTableRow">
                <td>
                    <label class="container">
                        <input type="checkbox">
                        <span class="checkmark"></span>
                    </label>
                </td>
                <td style="transform: translateX(-30px);"><b>Firstname Lastname</b> has met the requirements for this award: <b>AwardName</b></td>
                <td class="dbTablePH"></td>
                <td style="padding-right: 0px;">MM/DD/YYYY</td> <!--When the notification was sent-->
            </tr>
        </table>
    </div>
</div>