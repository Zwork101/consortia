<div id="filter-dialog-box" title="Filters">
    <form name="filter-settings" id="filter-settings" method="get">
        <fieldset>
            <div>
                <label for="filter-semester">Semester</label>
                <select name="filter-semester" id="filter-semester">
                    <option>Fall 2024</option>
                    <option>Spring 2024</option>
                    <option>Fall 2023</option>
                    <option>Spring 2023</option>
                    <option>Fall 2022</option>
                    <option>Spring 2022</option>
                    <option>Fall 2021</option>
                </select>
            </div>
            <div> 
                <label for="filter-membership">Membership</label>
                <select name="filter-membership" id="filter-membership">
					<option>All</option>
                    <option>Active Member</option>
                    <option>Non-Active Member</option>
                </select>    
            </div>
            <div>
                <label for="filter-semesters">Minimum Semesters</label>
                <input type="number" min="1" name="filter-semesters" id="filter-semesters" />
            </div>
            <div>
                <label for="filter-gen-meetings">Minimum Gen. Meetings</label>
                <input type="number" name="filter-gen-meetings" id="filter-gen-meetings" />
            </div>
            <div>
                <label for="filter-con-meetings">Minimum Com. Meetings</label>
                <input type="number" name="filter-con-meetings" id="filter-con-meetings" />
            </div>
            <div>
                <label for="filter-social-event">Minimum Social Event</label>
                <input type="number" name="filter-social-event" id="filter-social-event" />
            </div>
            <div>
                <label for="filter-volunteering">Minimum Volunteering</label>
                <input type="number" name="filter-volunteering" id="filter-volunteering">
            </div>
            <!-- allow for form submission without duplicating the dialog button-->
            <!-- <input type="submit" tabindex="-1" style="position: absolute; top: -1000px"> -->
        </fieldset>
    </form>
</div>

<div id="create-meeting-dialog-box" title="Create Meeting">
    <form name="create-meeting" id="create-meeting" method="post" action="/admin/{{ org_id }}/create">
        <fieldset>
            <div class="dialog-item">
                <label for="meeting_name">Title:</label>
                <input type="text" name="meeting_name" id="meeting_name">
            <div class="dialog-row">
                <div style="margin-top:10px;">
                    <label for="meeting-date">Date:</label>
                    <input type="date" name="meeting-date" id="meeting-date" style="padding: 8px 0px;">
                </div>
                <div style="margin-left:20px; margin-top:10px;">
                    <label for="meeting-time-start">Start Time:</label>
                    <input type="time" name="meeting-time-start" id="meeting-time-start">
                </div> 
                <div style=" margin-top:10px;">
                    <label for="meeting-time-end">End Time:</label>
                    <input type="time" name="meeting-time-end" id="meeting-time-end">
                </div>
            </div>
        </div>
            <div class="dialog-row">
                <div>
                    <div class="dialog-row";>
                        <label for="meeting_type">Meeting Type:</label>
                    </div>
                    <select name="meeting_type" id="meeting_type" style="padding: 10px; width:250px;">
                        <option>General</option>
                        <option>Committee</option>
                        <option>Social</option>
                        <option>Volunteering</option>
                        <option>Mentorship</option>
                    </select>
                </div>
                <div style="transform:translateX(-10px);">
                    <label for="meeting_location">Meeting Location:</label>
                    <input type="text" name="meeting_location" id="meeting_location">
                </div>
            </div>
            <div class="dialog-item" style="margin-top: 10px;">
                <label for="meeting_description">Description</label>
                <textarea id="meeting_description" name="meeting_description" rows="6" cols="58" style="min-width:520px"></textarea>
            </div>
            
            <!-- Hidden fields for combined datetime values -->
            <input type="hidden" id="meeting_start_time" name="meeting_start_time">
            <input type="hidden" id="meeting_end_time" name="meeting_end_time">
        </fieldset>
    </form>
</div>

{% include "widgets/meeting-upload.html.j2" %}

<div id="send-email-dialog-box" title="Send Email">
    <form name="send-email" id="send-email">
        <fieldset>
            <div>
                <label for="send-to">To:</label>
                <input type="text" name="send-to" id="send-to">
            </div>
            <div>
                <textarea id="email-message" rows="6" cols="58"></textarea>
            </div>
            <div class="add-file-button">
                <button>Add Files</button>
            </div>
        </fieldset>
    </form>
</div>

