{% extends "base.html.j2" %}
<!-- testing purporses only -->
{% block head %}
<script src="../static/js/mainjavascript.js"></script>
<script src="{{ url_for("static", filename="js/semester-sort-and-filter.js") }}" defer></script>
<script src="{{ url_for("static", filename="js/student-comms.js") }}" defer></script>
{% endblock %}
<!-- testing purporses only -->
{% block content %}
{% include "comstabs.html.j2" %}
    <main>
        <div class="points-bar">
            <div class="chart-bar"> <!--Flexbox-->
                <div id="mentor-bar"></div><!--Mentorship Program-->
                <div id="voluenteer-bar"></div><!--Volunteering-->
                <div id="attendance-bar"></div><!--Attendence-->
                <div id="misc-bar"></div><!--Miscellaneous-->
            </div>
            <div class="chart-labels"> <!--Flexbox-->
                <div>
                    <div></div> <!--Circle-->
                    <p>Mentorship Program (<span id="mentor-points"></span>)</p>
                </div>
                <div>
                    <div></div> <!--Circle-->
                    <p>Volunteering (<span id="voluenteering-points"></span>)</p>
                </div>
                <div>
                    <div></div> <!--Circle-->
                    <p>Attendance (<span id="attendance-points"></span>)</p>
                </div>
                <div>
                    <div></div> <!--Circle-->
                    <p>Miscellaneous (<span id="misc-points"></span>)</p>
                </div>
                <p><b><span id="earned-points"></span>/<span id="max-points"></span> Points</b></p>
            </div>
        </div>
        <div class="points-info-container">
            <section class="info-box-gray mentorship-points-box">
                <h2>Mentorship Program</h2>
                <div>
                    <p>Joined Program</p>
                    <p>3 Points</p>
                </div>
                <div>
                    <p>Per Meeting</p>
                    <p>1 Point</p>
                </div>
                <p class="small-text">Students are limited to a maximum of 9 points through the Membership Program.
                </p>
                <div class="extra-info">
                    <p>To find more information about the Mentorship Program, please visit <span
                            class="external-url">website name.</span></p>
                    <button class="learn-more">Learn More</button>
                </div>
            </section>
            <section class="info-box-gray volunteering-points-box">
                <h2>Volunteering</h2>
                <div>
                    <p>1-3 Hours</p>
                    <p>1 Point</p>
                </div>
                <div>
                    <p>3-6 Hours</p>
                    <p>2 Points</p>
                </div>
                <div>
                    <p>6-9 Hours</p>
                    <p>3 Points</p>
                </div>
                <div>
                    <p>9+ Hours</p>
                    <p>4 Points</p>
                </div>
                <div class="extra-info">
                    <p>To find more information about volunteering opportunities, please visit <span
                            class="external-url">website name.</span></p>
                    <button class="learn-more">Learn More</button>
                </div>
            </section>
            <section class="info-box-gray attendance-points-box">
                <h2>Attendance</h2>
                <div>
                    <p>50% of Meetings Attended</p>
                    <p>1 Points</p>
                </div>
                <div>
                    <p>75% of Meetings Attended</p>
                    <p>2 Points</p>
                </div>
                <div>
                    <p>100% of Meetings Attended</p>
                    <p>3 Points</p>
                </div>
            </section>
            <section class="info-box-gray miscellaneous-points-box">
                <h2>Miscellaneous</h2>
                <p>Miscellaneous points are available for helping the organization. Please reach out to <span
                        class="external-url">email address</span> to find out more.</p>
            </section>
        </div>
    </main>
{% endblock %}