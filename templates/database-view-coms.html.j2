{% extends "base.html.j2" %}
{% block head %}
<script src="../static/js/mainjavascript.js"></script>
<script src="{{ url_for("static", filename="js/admin.js") }}" defer></script>
{% endblock %}
{% block content %}
{% include "nav.html.j2" %}
<main>

    <div class="database-dropdown-large1">
        <button onclick="dropDown1()" class="dropbtn1">
            COMS Student Data
            <span class="dropDownArrow"><img src="../static/images/down-arrow-black.png" width="16" /></span>
        </button>
        <div id="DropdownContent1" class="dropdown-content-large1">
            <a>COMS Attendance Data</a>
        </div>
    </div>

    <div class="database-dropdown-large2">
        <button onclick="dropDown2()" class="dropbtn2">
            Fall 2024
            <span class="dropDownArrow"><img src="../static/images/down-arrow-black.png" width="16" /></span>
        </button>
        <div id="DropdownContent2" class="dropdown-content-large2">
            <a>Spring 2024</a>
            <a>Fall 2023</a>
            <a>Spring 2023</a>
            <a>Fall 2022</a>
            <a>Spring 2022</a>
            <a>Fall 2021</a>
        </div>
    </div>


    <div class="database-dropdown-medium">
        <button onclick="dropDown3()" class="dropbtn3">
            Filter by: First Name
            <span class="dropDownArrow"><img src="../static/images/down-arrow-black.png" width="16" /></span>
        </button>
        <div id="DropdownContent3" class="dropdown-content-medium">
            <a>Filter by: Last Name</a>
            <a>Filter by: Email</a>
            <a>Filter by: Membership</a>
            <a>Filter by: Semesters</a>
        </div>
    </div>


    <div class="search-container">
        <input type="text" id="search" placeholder="Search Students">
    </div>

    <div class="optbutton">
        <button><img src="../static/images/opticon1.png" width="32" /></button>
    </div>

    <div class="optbutton">
        <button><img src="../static/images/opticon2.png" width="32" /></button>
    </div>

    <div class="optbutton">
        <button><img src="../static/images/opticon3.png" width="32" /></button>
    </div>

    <div class="optbutton">
        <button><img src="../static/images/opticon4.png" width="32" /></button>
    </div>

    <div class="confbutton">
        <button><img src="../static/images/conficon1.png" width="32" /></button>
    </div>

    <table class="dbTable" id="orgMembers">
        <tr class="dbTableTop">
            <th></th>
            <th>FIRST NAME</th>
            <th>LAST NAME</th>
            <th>MEMBERSHIP</th>
            <th>SEMESTER</th>
            <th>E-MAIL ADRESS</th>
            <th>MENTORSHIP</th>
            <th>VOLUNTEERING</th>
            <th>ATTENDANCE</th>
            <th>MISC</th>
            <th>TOTAL POINTS</th>
            <th class="dbTablePH"></th>
            <th></th>
        </tr>
        
    </table>
</main>
{% endblock %}